# Optional AI-coaching backend (api/feedback.js). Copy to .env (or set in your host's dashboard).
# The page works fully without these — it falls back to static cue feedback (standard rule B-35).

# Your Anthropic API key. Server-side ONLY — never expose it in the page (B-38).
ANTHROPIC_API_KEY=

# Lock CORS to the origin that serves the page, e.g. https://example.com
# Defaults to "*" (permissive) if unset — set it for production.
ALLOWED_ORIGIN=
